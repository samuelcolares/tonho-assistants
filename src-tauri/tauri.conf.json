{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonho Assistants",
  "version": "0.2.0",
  "identifier": "com.krieg.fileorganizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tonho Assistants",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMjYyMjc5QjVDRUMzMjgKUldRb3c4NjFlU0ltMDNhM1d5em9KcktRYXVoOVhHS2RqQXFZQmNUWlZNSmRXYUloU1BuVEJnUlcK",
      "endpoints": [
        "https://github.com/samuelcolares/tonho-assistants/releases/latest/download/latest.json"
      ]
    }
  }
}
